#!/bin/sh /etc/rc.common
# Ah-Ha household presence → trail. See /usr/bin/aha-presence.

START=99
USE_PROCD=1

start_service() {
	[ -f /etc/aha-presence.conf ] || return 1
	procd_open_instance
	procd_set_param command /usr/bin/aha-presence
	procd_set_param respawn 3600 10 0
	procd_set_param stderr 1
	procd_close_instance
}
